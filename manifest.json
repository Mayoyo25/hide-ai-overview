{
  "manifest_version": 3,
  "name": "Hide AI Overview",
  "version": "1.1.1",
  "description": "Hides Google's AI Overview from search results. Click the toolbar icon to toggle on/off.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "*://www.google.com/*",
    "*://www.google.co.ke/*",
    "*://www.google.co.uk/*",
    "*://www.google.ca/*",
    "*://www.google.com.au/*",
    "*://www.google.de/*",
    "*://www.google.fr/*",
    "*://www.google.co.in/*",
    "*://www.google.es/*",
    "*://www.google.it/*",
    "*://www.google.nl/*",
    "*://www.google.co.za/*",
    "*://www.google.com.ng/*",
    "*://www.google.co.tz/*",
    "*://www.google.co.ug/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*",
        "*://www.google.co.ke/search*",
        "*://www.google.co.uk/search*",
        "*://www.google.ca/search*",
        "*://www.google.com.au/search*",
        "*://www.google.de/search*",
        "*://www.google.fr/search*",
        "*://www.google.co.in/search*",
        "*://www.google.es/search*",
        "*://www.google.it/search*",
        "*://www.google.nl/search*",
        "*://www.google.co.za/search*",
        "*://www.google.com.ng/search*",
        "*://www.google.co.tz/search*",
        "*://www.google.co.ug/search*"
      ],
      "css": ["hide.css"],
      "js": ["hide.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Toggle Hide AI Overview",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}